// ===== TAMBAHAN Firestore Rules untuk akun PENGAJAR (portal-pengajar.html) =====
// File firestore.rules Anda tidak saya terima, jadi ini BUKAN pengganti: gabungkan (merge)
// blok di bawah ke dalam `match /databases/{database}/documents { ... }` yang sudah ada,
// lalu klik Publish di Firebase Console -> Firestore Database -> Rules.
// Jika di rules lama sudah ada `match /santri/{id}` dst., tambahkan kondisi `|| pengajar()` pada
// baris `allow read` / `allow create, update` yang sesuai (jangan menulis dua match untuk path yang sama
// dengan aturan bertentangan; di Firestore aturan yang cocok digabung dengan OR, jadi boleh juga).

function masuk()    { return request.auth != null; }
function stafDoc()  { return get(/databases/$(database)/documents/staf/$(request.auth.uid)).data; }
function adaStaf()  { return masuk() && exists(/databases/$(database)/documents/staf/$(request.auth.uid)); }
function pengajar() { return adaStaf() && stafDoc().status != 'Nonaktif'; }   // Pengajar maupun Kepala

// Pengajar membaca dokumen akunnya sendiri (dipakai masuk.html / db.js -> tujuan())
match /staf/{uid} {
  allow get: if masuk() && request.auth.uid == uid;
}

// Data santri: pengajar boleh membaca; hanya boleh mengubah level & catatan pengajar
match /santri/{id} {
  allow read: if pengajar();
  allow update: if pengajar()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['level', 'catatanGuru']);
}

// Absensi & hafalan: pengajar boleh membaca, menambah, dan mengubah (hapus tetap hanya admin)
match /absensi/{id} {
  allow read, create, update: if pengajar();
}
match /hafalan/{id} {
  allow read, create, update: if pengajar();
}

