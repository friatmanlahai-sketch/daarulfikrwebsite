rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    // GANTI dengan email akun admin yang Anda buat di Firebase Authentication.
    // Hanya email di daftar ini yang dianggap admin. Akun orang tua TIDAK bisa menjadi admin.
    function admin() {
      return signed() && request.auth.token.email in ['rqldaarulfikrtolondadu@gmail.com'];
    }
    // Direktur = akun staf berperan Direktur yang aktif. Boleh MELIHAT data dan mengelola pengumuman, tidak boleh mengubah data lain.
    function kepala() {
      return signed()
        && exists(/databases/$(database)/documents/staf/$(request.auth.uid))
        && get(/databases/$(database)/documents/staf/$(request.auth.uid)).data.get('peran', '') in ['Direktur','Kepala']
        && get(/databases/$(database)/documents/staf/$(request.auth.uid)).data.get('status', 'Aktif') != 'Nonaktif';
    }
    // Pengajar = akun staf berperan Pengajar yang aktif. Dipakai portal-pengajar.html untuk mengontrol santri.
    function pengajar() {
      return signed()
        && exists(/databases/$(database)/documents/staf/$(request.auth.uid))
        && get(/databases/$(database)/documents/staf/$(request.auth.uid)).data.get('peran', '') == 'Pengajar'
        && get(/databases/$(database)/documents/staf/$(request.auth.uid)).data.get('status', 'Aktif') != 'Nonaktif';
    }
    // Orang tua hanya boleh mengakses data anak yang sudah ditautkan ke akunnya.
    function ownerOf(sid) {
      return signed()
        && exists(/databases/$(database)/documents/santri/$(sid))
        && get(/databases/$(database)/documents/santri/$(sid)).data.get('ortuUid', '') == request.auth.uid;
    }

    // ---- Santri ----
    match /santri/{id} {
      // Publik boleh mendaftar. Jika menyertakan ortuUid, harus uid akun yang sedang login.
      allow create: if request.resource.data.status == 'Menunggu'
        && request.resource.data.nama is string && request.resource.data.nama.size() < 100
        && request.resource.data.keys().hasAll(['nama', 'no', 'hp', 'ortu'])
        && (!('foto' in request.resource.data) || (request.resource.data.foto is string && request.resource.data.foto.size() < 200000))
        && (!('ortuUid' in request.resource.data) || (signed() && request.resource.data.ortuUid == request.auth.uid));
      allow read: if (signed() && resource.data.get('ortuUid', '') == request.auth.uid) || pengajar();
      // Pengajar hanya boleh mengubah kemampuan bacaan, catatan, dan foto santri.
      allow update: if pengajar() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['level', 'catatan', 'foto'])
        && (!('foto' in request.resource.data) || (request.resource.data.foto is string && request.resource.data.foto.size() < 200000));
      // Orang tua hanya boleh mengubah kontak anaknya.
      allow update: if signed() && resource.data.get('ortuUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hp', 'alamat']);
    }

    // ---- Data anak: orang tua hanya membaca; boleh mengajukan izin/sakit ----
    match /absensi/{id} {
      allow read: if ownerOf(resource.data.sid) || pengajar();
      allow create: if pengajar() && request.resource.data.ket in ['Hadir', 'Izin', 'Sakit', 'Alpa'];
      allow update: if pengajar() && request.resource.data.ket in ['Hadir', 'Izin', 'Sakit', 'Alpa']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ket', 'catatan', 'oleh', 'ouid']);
      allow create: if ownerOf(request.resource.data.sid)
        && request.resource.data.ket in ['Izin', 'Sakit']
        && request.resource.data.keys().hasOnly(['tanggal', 'sid', 'snama', 'ket', 'catatan', 'oleh', 'tgl']);
    }
    match /hafalan/{id} {
      allow read: if ownerOf(resource.data.sid) || pengajar();
      allow create: if pengajar() && request.resource.data.ouid == request.auth.uid;
      allow update, delete: if pengajar() && resource.data.get('ouid', '') == request.auth.uid;
    }
    match /bayar/{id} { allow read: if ownerOf(resource.data.sid); }

    // ---- Akun orang tua ----
    match /ortu/{uid} {
      allow read, create, update: if signed() && request.auth.uid == uid;
    }
    match /tautan/{id} {
      allow create: if signed() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'Menunggu'
        && request.resource.data.keys().hasOnly(['uid', 'nama', 'hp', 'no', 'lahir', 'status', 'tgl']);
      allow read: if signed() && resource.data.uid == request.auth.uid;
    }

    // ---- Publik ----
    match /status/{no} {
      allow get: if true;
      allow create: if request.resource.data.status == 'Menunggu';
    }
    match /pengumuman/{id} { allow read: if true; allow write: if kepala(); }
    match /program/{id} { allow read: if true; }
    match /jadwal/{id} { allow read: if true; }
    match /pengajar/{id} {
      allow read: if true;
      // Pengajar boleh mengganti foto miliknya sendiri di halaman publik (dokumen staf_<uid>).
      allow update: if pengajar() && id == 'staf_' + request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['foto'])
        && request.resource.data.foto is string && request.resource.data.foto.size() < 200000;
    }
    match /struktur/{id} { allow read: if true; }
    // Akun staf: tiap staf hanya dapat membaca dokumennya sendiri (dipakai untuk mengenali peran Direktur).
    match /staf/{uid} {
      allow get: if signed() && request.auth.uid == uid;
      // Pengajar & Direktur boleh mengubah foto dan biodatanya sendiri (bukan nama, peran, atau status).
      allow update: if signed() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['foto', 'hp', 'jk', 'tempat', 'lahir', 'pendidikan', 'alamat', 'nik', 'kk', 'nikah', 'pasangan', 'anak', 'desa', 'kecamatan', 'kabupaten', 'provinsi', 'kodepos', 'kampus', 'jurusan', 'npwp', 'mulai', 'keahlian', 'pelatihan', 'riwayatpend', 'prestasi', 'ijazah', 'sertifikat', 'darurat'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['foto'])
            || (request.resource.data.foto is string && request.resource.data.foto.size() < 200000))
        && request.resource.data.get('hp', '').size() < 100
        && request.resource.data.get('jk', '').size() < 100
        && request.resource.data.get('tempat', '').size() < 100
        && request.resource.data.get('lahir', '').size() < 100
        && request.resource.data.get('pendidikan', '').size() < 100
        && request.resource.data.get('alamat', '').size() < 300
        && request.resource.data.get('nik', '').size() < 100
        && request.resource.data.get('kk', '').size() < 100
        && request.resource.data.get('nikah', '').size() < 100
        && request.resource.data.get('pasangan', '').size() < 100
        && request.resource.data.get('anak', '').size() < 100
        && request.resource.data.get('desa', '').size() < 100
        && request.resource.data.get('kecamatan', '').size() < 100
        && request.resource.data.get('kabupaten', '').size() < 100
        && request.resource.data.get('provinsi', '').size() < 100
        && request.resource.data.get('kodepos', '').size() < 100
        && request.resource.data.get('kampus', '').size() < 100
        && request.resource.data.get('jurusan', '').size() < 100
        && request.resource.data.get('npwp', '').size() < 100
        && request.resource.data.get('mulai', '').size() < 100
        && request.resource.data.get('sertifikat', '').size() < 4000
        && request.resource.data.get('keahlian', '').size() < 3000
        && request.resource.data.get('pelatihan', '').size() < 10000
        && request.resource.data.get('riwayatpend', '').size() < 4000
        && request.resource.data.get('prestasi', '').size() < 9000
        && request.resource.data.get('ijazah', '').size() < 4000
        && request.resource.data.get('darurat', '').size() < 100;
    }
    // Berkas unggahan (sertifikat, ijazah, prestasi): satu dokumen per berkas. Hanya pemiliknya yang boleh membaca,
    // menambah, dan menghapus; admin dan Direktur tetap bisa membaca lewat aturan umum di bawah.
    match /berkas/{id} {
      allow read: if signed() && resource.data.pemilik == request.auth.uid;
      allow create: if signed() && request.resource.data.pemilik == request.auth.uid
        && request.resource.data.keys().hasOnly(['pemilik', 'jenis', 'nama', 'tipe', 'data', 'tgl'])
        && request.resource.data.jenis in ['sertifikat', 'pelatihan', 'prestasi', 'ijazah']
        && request.resource.data.data is string && request.resource.data.data.size() < 800000
        && request.resource.data.get('nama', '').size() < 200 && request.resource.data.get('tipe', '').size() < 100;
      allow delete: if signed() && resource.data.pemilik == request.auth.uid;
    }
    match /galeri/{id} { allow read: if true; }
    match /pengaturan/{id} { allow read: if true; }
    match /sorotan/{id} { allow read: if true; }
    match /keunggulan/{id} { allow read: if true; }
    match /alur/{id} { allow read: if true; }
    match /faq/{id} { allow read: if true; }
    match /statistik/{id} { allow read: if true; }
    match /agenda/{id} { allow read: if true; }
    match /testimoni/{id} { allow read: if true; }

    // ---- Admin: semuanya ----
    // Direktur boleh membaca semua kecuali koleksi 'admin' (supaya tidak dikira admin oleh panel).
    match /{col}/{id} {
      allow read: if admin() || (kepala() && col != 'admin');
      allow write: if admin();
    }
  }
}
